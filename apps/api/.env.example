# Remote Turso database
# Get the DB name and DB auth token and paste in .env
DATABASE_URL=
TURSO_AUTH_TOKEN=your-auth-token

# Optional: browser origins allowed to call the API directly (waitlist only).
# All authenticated/private calls go through the SvelteKit BFF, so no CORS needed there.
CORS_ORIGINS=http://localhost:5173

# WorkOS credentials (staging for local dev)
WORKOS_CLIENT_ID=
WORKOS_CLIENT_SECRET=

# Port the API listens on
PORT=8080
