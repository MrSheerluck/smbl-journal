# ── Local development ─────────────────────────────────────────────

# Rust API base URL, used by the SvelteKit BFF (server-to-server).
# Server-side only — never exposed to the browser.
API_URL=http://localhost:8080

# Public: used by the waitlist form (browser → API). Only needed for that call.
PUBLIC_API_URL=http://localhost:8080

# The web app's own origin. Used for redirects that must be absolute.
WEB_ORIGIN=http://localhost:5173

# WorkOS
WORKOS_CLIENT_ID=

# Set to "true" in production (HTTPS). Leave false for http://localhost dev.
SECURE_COOKIES=false

# ── Production (Phase 6 deploy) ───────────────────────────────────
# API_URL=https://api.smbl.dev
# PUBLIC_API_URL=https://api.smbl.dev
# WEB_ORIGIN=https://journal.smbl.dev
# WORKOS_CLIENT_ID=<production client id>
# SECURE_COOKIES=true
